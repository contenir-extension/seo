{
    "name": "contenir-extension/seo",
    "description": "The SEO add-on for Contenir CMS: page titles, share defaults, hiding copies from search engines, site verification, the site's owner as JSON-LD, the XML sitemap and robots.txt.",
    "type": "contenir-extension",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "contenir-extension",
        "seo",
        "sitemap",
        "robots",
        "json-ld"
    ],
    "support": {
        "issues": "https://github.com/contenir-extension/seo/issues",
        "source": "https://github.com/contenir-extension/seo"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/extension-api": "^0.5 || ^0.6",
        "contenir/contenir-seo": "^0.1"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "nyholm/psr7": "^1.8.2",
        "phpunit/phpunit": "^11.5.42"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/contenir/contenir-seo"
        }
    ],
    "autoload": {
        "psr-4": {
            "Contenir\\Extension\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Extension\\Seo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "boundary": "extension-boundary",
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint",
            "mago guard"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "extra": {
        "contenir": {
            "handle": "seo",
            "extension": "Contenir\\Extension\\Seo\\SeoExtension"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
