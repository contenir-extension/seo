<?php
/**
 * The SEO area's home: how the site reads in search as a score with each section's beneath it, what there is
 * to do (the records' issues, by impact), and how the site's own setup stands, each leading to where it's fixed.
 *
 * @var array{
 *     sections: list<\Contenir\Extension\Seo\Report\SectionIssues>,
 *     health: \Contenir\Extension\Seo\Health\SiteHealth,
 *     ago: ?string,
 *     roles: array<string, string>,
 *     checks: list<array{label: string, status: string, message: string}>,
 *     settings: array<string, string>,
 *     records: bool,
 * } $values
 * @var \Contenir\Extension\Api\Module\TemplateHelpersInterface $view
 */

use Contenir\Extension\Seo\Health\Tier;
use Contenir\Extension\Seo\Module\SettingsLinks;

$health   = $values['health'];
$score    = $health->score;
$arc      = M_PI * 80;
$groups   = [];
$titles   = [];
foreach ($health->fixFirst() as $issue) {
    $groups[$issue->kind->tier()->value][] = $issue;
}
foreach ($values['sections'] as $each) {
    $titles[$each->section] = $each->title;
}
$tones    = ['success' => 'var(--success)', 'warning' => 'var(--warning)', 'destructive' => 'var(--destructive)'];
$badges   = [Tier::High->value => 'destructive', Tier::Medium->value => 'warning', Tier::Low->value => 'info'];
?>
                <div class="pageheader pageheader--row pageheader--sticky">
                    <div class="pageheader__content">
                        <h1 class="pageheader__title">SEO</h1>
                    </div>
                    <div class="pageheader__actions">
                        <form method="post" action="<?= $view->escape($view->url('records-check')) ?>">
                            <?= $view->token() ?>
                            <button type="submit" class="btn btn--outline" title="Asks the site about each page again. It changes nothing, and doesn't affect Site-wide."><?= $view->icon('refresh') ?><span><?= null === $values['ago'] ? 'Check with the site' : 'Re-check now' ?></span></button>
                        </form>
                    </div>
                </div>
                <?= $view->tabs() ?>

                <div class="stack stack--lg">
                <section class="card">
                    <div class="card__header">
                        <h2 class="card__title">Overall rank<?php if (null !== $score->value): ?> <span class="badge badge--<?= $view->escape($score->tone()) ?>"><?= $view->escape($score->label()) ?></span><?php endif ?></h2>
                        <?php if (null !== $values['ago']): ?><p class="card__description">Checked <?= $view->escape($values['ago']) ?> ago</p><?php endif ?>
                    </div>
                    <div class="card__content">
<?php if (null === $score->value || [] === $values['sections']): ?>
                        <div class="empty">
                            <div class="empty__content">
                                <h3 class="empty__title">No sections described yet</h3>
                                <p class="empty__description">Add an &lt;seo&gt; block to a section with pages of its own in admin.xml.</p>
                            </div>
                        </div>
<?php else: ?>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2rem; align-items: center">
                            <div style="display: flex; justify-content: center">
                                <svg width="260" height="152" viewBox="0 0 200 116" role="img" aria-label="Score <?= $score->value ?> of 100">
                                    <path d="M20 100A80 80 0 0 1 180 100" fill="none" stroke="var(--bg-muted)" stroke-width="14" stroke-linecap="round"/>
                                    <path d="M20 100A80 80 0 0 1 180 100" fill="none" stroke="<?= $view->escape($tones[$score->tone()]) ?>" stroke-width="14" stroke-linecap="round" stroke-dasharray="<?= round($arc * $score->value / 100, 1) ?> <?= round($arc, 1) ?>"/>
                                    <text x="100" y="92" text-anchor="middle" font-size="46" font-weight="700" fill="var(--fg)"><?= $score->value ?></text>
                                    <text x="100" y="112" text-anchor="middle" font-size="11" fill="var(--fg-muted)">out of 100</text>
                                </svg>
                            </div>
                            <ul class="stack stack--md" style="list-style: none; margin: 0; padding: 0" aria-label="By section">
<?php foreach ($values['sections'] as $index => $section): ?>
<?php
$one    = $health->sections[$index];
$fixes  = [];
$total  = 0;
$counts = [];
foreach (['title' => ['title', 'titles'], 'description' => ['description', 'descriptions'], 'image' => ['image', 'images'], 'discoverable' => ['hidden', 'hidden']] as $role => [$single, $many]) {
    $count          = $section->count($role);
    $counts[$role]  = $count;
    if (0 < $count) {
        $total += 'discoverable' === $role ? 0 : $count;
        $fixes[] = ['role' => $role, 'text' => $count . ' ' . (1 === $count ? $single : $many)];
    }
}
?>
                                <li data-section="<?= $view->escape($section->section) ?>" data-n-title="<?= $counts['title'] ?>" data-n-description="<?= $counts['description'] ?>" data-n-image="<?= $counts['image'] ?>" data-n-discoverable="<?= $counts['discoverable'] ?>">
                                    <div class="cluster cluster--sm" style="justify-content: space-between; align-items: baseline">
                                        <span>
                                            <a class="text--medium" data-role="name" href="<?= $view->escape($view->url('records', ['section' => $section->section])) ?>"><?= $view->escape($section->title) ?></a>
                                            <span class="text--muted text--xs"><span data-role="records"><?= $section->checked ?></span> <?= 1 === $section->checked ? 'record' : 'records' ?> · <span data-role="inspected"><?= $section->inspected ?></span> checked</span>
                                        </span>
                                        <span class="text--medium"><?= null === $one->score->value ? '–' : $one->score->value ?></span>
                                    </div>
<?php if (null !== $one->score->value): ?>
                                    <div class="progress" role="img" aria-label="<?= $view->escape($section->title) ?> scores <?= $one->score->value ?> of 100" style="margin-block: 0.375rem"><div class="progress__bar" style="width: <?= $one->score->value ?>%; background-color: <?= $view->escape($tones[$one->score->tone()]) ?>"></div></div>
<?php endif ?>
                                    <div class="cluster cluster--sm text--xs text--muted" style="justify-content: space-between">
                                        <span>
<?php if ([] === $fixes): ?>
                                            Nothing to fix
<?php else: ?>
<?php foreach ($fixes as $position => $fix): ?>
                                            <?= 0 < $position ? '· ' : '' ?><a href="<?= $view->escape($view->url('records', ['section' => $section->section, 'role' => $fix['role']])) ?>"><?= $view->escape($fix['text']) ?></a>
<?php endforeach ?>
<?php endif ?>
                                        </span>
<?php if (0 < $total): ?>
                                        <a class="text--medium" href="<?= $view->escape($view->url('records', ['section' => $section->section])) ?>">Fix <?= $total ?></a>
<?php endif ?>
                                    </div>
                                </li>
<?php endforeach ?>
                            </ul>
                        </div>
<?php endif ?>
                    </div>
                </section>

                <div class="grid grid--2">
                    <section class="card">
                        <div class="card__header">
                            <h2 class="card__title">To do</h2>
                        </div>
                        <div class="card__content">
<?php $todo = array_values(array_filter($health->fixFirst(), static fn($issue): bool => ! $issue->kind->siteWide())); ?>
<?php if ([] === $todo): ?>
                            <p class="text--sm text--muted"><?= $view->icon('circle-check') ?> Nothing to do.</p>
<?php else: ?>
                            <ol class="stack stack--md" style="list-style: none; margin: 0; padding: 0">
<?php foreach ($todo as $issue): ?>
                                <li class="cluster cluster--sm" style="align-items: center; justify-content: space-between">
                                    <span class="cluster cluster--sm" style="flex: 1; min-width: 0; align-items: center">
                                        <span class="badge badge--<?= $view->escape($badges[$issue->kind->tier()->value]) ?>"><?= $view->escape($issue->kind->tier()->label()) ?></span>
                                        <span style="min-width: 0">
                                            <span class="text--medium text--sm" style="display: block"><?= $view->escape($issue->kind->label()) ?></span>
                                            <span class="text--xs text--muted" style="display: block"><?= $view->escape(implode(', ', array_map(static fn(string $key, int $count): string => ($titles[$key] ?? $key) . ' ' . $count, array_keys($issue->sections), $issue->sections))) ?></span>
                                        </span>
                                    </span>
                                    <a class="btn btn--outline btn--sm" href="<?= $view->escape($view->url('records', ['kind' => $issue->kind->value])) ?>" aria-label="Fix <?= $issue->count ?> <?= 1 === $issue->count ? 'record' : 'records' ?>: <?= $view->escape($issue->kind->label()) ?>"><?= $view->icon('tool') ?><span>Fix</span></a>
                                </li>
<?php endforeach ?>
                            </ol>
<?php endif ?>
                        </div>
                    </section>

                    <section class="card">
                        <div class="card__header">
                            <h2 class="card__title">Site setup</h2>
                        </div>
                        <div class="card__content">
<?php
$settingUrl = static fn(string $title): string => SettingsLinks::editing((string) (array_search($title, $values['settings'], true) ?: array_key_first($values['settings'])));
$setup      = [];
foreach ($values['checks'] as $check) {
    $ok      = 'success' === $check['status'];
    $setup[] = [
        'key'    => strtolower(trim((string) preg_replace('/[^a-z0-9]+/i', '-', $check['label']), '-')),
        'label'  => $check['label'],
        'ok'     => $ok,
        'note'   => $check['message'],
        'action' => $ok ? null : ('Sitemap' === $check['label'] ? ['Open', $settingUrl('Sitemap')] : ['Set up', $settingUrl('Search Appearance')]),
    ];
}
$setup[] = [
    'key'    => 'records',
    'label'  => "Each record's own search settings",
    'ok'     => $values['records'],
    'note'   => $values['records']
        ? 'The image variants, overrides and structured data a record sets reach the site.'
        : 'None of what records say about themselves reaches the site yet. Turn it on in Search Appearance, under This environment, once the records are fixed.',
    'action' => $values['records'] ? null : ['Turn on', $settingUrl('Search Appearance')],
];
?>
                            <ul class="stack stack--md" style="list-style: none; margin: 0; padding: 0">
<?php foreach ($setup as $row): ?>
                                <li data-setup="<?= $view->escape($row['key']) ?>" data-status="<?= $row['ok'] ? 'ok' : 'todo' ?>">
                                    <div class="cluster cluster--sm" style="align-items: center; justify-content: space-between">
                                        <span class="cluster cluster--sm" style="align-items: center">
                                            <span style="color: <?= $row['ok'] ? 'var(--success)' : 'var(--warning)' ?>"><?= $view->icon($row['ok'] ? 'circle-check' : 'alert-circle') ?></span>
                                            <span class="text--sm text--medium"><?= $view->escape($row['label']) ?></span>
                                            <button type="button" class="btn btn--ghost btn--icon btn--sm field-info__toggle" aria-label="About <?= $view->escape($row['label']) ?>" aria-expanded="false" aria-controls="setup-note-<?= $view->escape($row['key']) ?>" data-info-toggle><?= $view->icon('info-circle') ?></button>
                                        </span>
<?php if (null !== $row['action']): ?>
                                        <a class="btn btn--outline btn--sm" href="<?= $view->escape($row['action'][1]) ?>"><?= $view->escape($row['action'][0]) ?></a>
<?php else: ?>
                                        <span class="text--xs text--muted">Done</span>
<?php endif ?>
                                    </div>
                                    <div class="field-info" id="setup-note-<?= $view->escape($row['key']) ?>">
                                        <div class="field-info__inner"><p class="form__description" data-note><?= $view->escape($row['note']) ?></p></div>
                                    </div>
                                </li>
<?php endforeach ?>
                            </ul>
                        </div>
                        <nav class="card__footer card__footer--border cluster cluster--xs" aria-label="SEO settings">
<?php foreach ($values['settings'] as $url => $title): ?>
                            <a class="btn btn--ghost btn--sm" href="<?= $view->escape($url) ?>"><?= $view->icon('settings') ?><span><?= $view->escape($title) ?></span></a>
<?php endforeach ?>
                        </nav>
                    </section>
                </div>
                </div>
