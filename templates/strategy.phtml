<?php
/**
 * How each section's pages are described for search: the schema type and where the title, description and image
 * are read from, listed, and one section's form to change them where the site saves its configuration.
 *
 * @var array{
 *     strategies: list<\Contenir\Extension\Seo\Strategy\SectionStrategy>,
 *     editing: ?\Contenir\Extension\Seo\Strategy\SectionStrategy,
 *     saves: bool,
 *     version: string,
 *     roles: list<string>,
 * } $values
 * @var \Contenir\Extension\Api\Module\TemplateHelpersInterface $view
 */

$labels  = ['title' => 'Title', 'description' => 'Description', 'image' => 'Image'];
$editing = $values['editing'];
?>
                <div class="pageheader pageheader--row pageheader--sticky">
                    <div class="pageheader__content">
                        <h1 class="pageheader__title">SEO</h1>
                    </div>
                </div>

                <div class="stack stack--lg">
<?php if (! $values['saves']): ?>
                    <div class="alert alert--info" role="note">
                        <p class="alert__text">This site saves its configuration where it is developed, not here. To change how a section is described, change its &lt;seo&gt; block in admin.xml and deploy.</p>
                    </div>
<?php endif ?>
<?php if (null !== $editing): ?>
<?php $off = $values['saves'] ? '' : ' disabled'; ?>
                    <form class="form form--record" method="post" action="<?= $view->escape($view->url('strategy-save')) ?>">
                        <?= $view->token() ?>
                        <input type="hidden" name="section" value="<?= $view->escape($editing->section) ?>">
                        <input type="hidden" name="version" value="<?= $view->escape($values['version']) ?>">
                        <fieldset class="card form__card" aria-labelledby="strategy-type">
                            <h2 class="card__header form__card-title" id="strategy-type"><?= $view->escape($editing->title) ?></h2>
                            <div class="card__content form__card-body">
                                <div class="form__row-group">
                                    <div class="form__row">
                                        <div class="form__col">
                                            <div class="form__field">
                                                <label class="form__label" for="strategy-schema">Schema type</label>
                                                <input class="input" type="text" id="strategy-schema" name="schema" list="strategy-schemas" value="<?= $view->escape($editing->schema) ?>" placeholder="WebPage" aria-describedby="strategy-schema-desc"<?= $off ?>>
                                                <datalist id="strategy-schemas">
<?php foreach (['WebPage', 'Article', 'BlogPosting', 'NewsArticle', 'CreativeWork', 'Product', 'Event', 'Person', 'Organization', 'LocalBusiness'] as $type): ?>
                                                    <option value="<?= $view->escape($type) ?>"></option>
<?php endforeach ?>
                                                </datalist>
                                                <p class="form__description" id="strategy-schema-desc">The schema.org type of this section's pages.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form__row">
                                        <div class="form__col">
                                            <div class="form__field">
                                                <span class="form__label" id="strategy-mode-label">What is taken from content</span>
                                                <div class="radio-group" role="radiogroup" aria-labelledby="strategy-mode-label">
                                                    <label class="radio-group__item"><input type="radio" class="radio-group__input" name="mode" value="automatic"<?= $editing->automatic ? ' checked' : '' ?><?= $off ?>><span class="radio-group__label">Automatic</span></label>
                                                    <label class="radio-group__item"><input type="radio" class="radio-group__input" name="mode" value="manual"<?= $editing->automatic ? '' : ' checked' ?><?= $off ?>><span class="radio-group__label">Manual</span></label>
                                                </div>
                                                <p class="form__description">Automatic: the page uses it, and the record shows "Taken from content" with nothing to fix. Manual: it is only a suggestion, and the record keeps its warning until you use it as the record's own.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
<?php foreach ($values['roles'] as $role): ?>
<?php $chosen = $editing->sourcesOf($role); $slots = max(3, count($chosen) + 1); $options = array_values(array_unique([...$editing->fields, ...$chosen])); ?>
                        <fieldset class="card form__card" aria-labelledby="strategy-<?= $view->escape($role) ?>">
                            <h2 class="card__header form__card-title" id="strategy-<?= $view->escape($role) ?>"><?= $view->escape($labels[$role]) ?></h2>
                            <div class="card__content form__card-body">
                                <div class="form__row-group">
                                    <div class="form__row">
<?php for ($slot = 0; $slot < $slots; ++$slot): ?>
                                        <div class="form__col">
                                            <div class="form__field">
                                                <label class="form__label" for="strategy-<?= $view->escape($role) ?>-<?= $slot ?>"><?= 0 === $slot ? 'Read from' : 'Otherwise' ?></label>
                                                <select class="select" id="strategy-<?= $view->escape($role) ?>-<?= $slot ?>" name="sources[<?= $view->escape($role) ?>][]"<?= $off ?>>
                                                    <option value="">–</option>
<?php foreach ($options as $field): ?>
                                                    <option value="<?= $view->escape($field) ?>"<?= ($chosen[$slot] ?? null) === $field ? ' selected' : '' ?>><?= $view->escape($field) ?></option>
<?php endforeach ?>
                                                </select>
                                            </div>
                                        </div>
<?php endfor ?>
                                    </div>
<?php if (in_array($role, ['description', 'image'], true)): ?>
                                    <div class="form__row">
                                        <div class="form__col">
                                            <div class="form__field">
                                                <label class="checkbox"><input type="hidden" name="content[<?= $view->escape($role) ?>]" value="0"><input type="checkbox" class="checkbox__input" name="content[<?= $view->escape($role) ?>]" value="1"<?= $editing->takesContent($role) ? ' checked' : '' ?><?= $off ?>> <span>From content</span></label>
                                                <p class="form__description">Where none of those has a value, use what the record's Section field gives.</p>
                                            </div>
                                        </div>
                                    </div>
<?php endif ?>
<?php if ('image' === $role): ?>
                                    <div class="form__row">
                                        <div class="form__col">
                                            <div class="form__field">
                                                <label class="form__label" for="strategy-alt">Alt text</label>
                                                <select class="select" id="strategy-alt" name="alt"<?= $off ?>>
                                                    <option value="">The title</option>
<?php foreach (array_values(array_unique([...$editing->fields, ...('' === $editing->altSource() ? [] : [$editing->altSource()])])) as $field): ?>
                                                    <option value="<?= $view->escape($field) ?>"<?= $editing->altSource() === $field ? ' selected' : '' ?>><?= $view->escape($field) ?></option>
<?php endforeach ?>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
<?php endif ?>
                                </div>
                            </div>
                        </fieldset>
<?php endforeach ?>
                        <fieldset class="form__actions form__actions--bar">
                            <a class="btn btn--outline" href="<?= $view->escape($view->url('strategy')) ?>"><?= $view->icon('x') ?><span class="btn__label"><?= $values['saves'] ? 'Cancel' : 'Back' ?></span></a>
<?php if ($values['saves']): ?>
                            <button type="submit" class="btn btn--primary">Save</button>
<?php endif ?>
                        </fieldset>
                    </form>
<?php else: ?>
                    <section class="card">
<?php if ([] === $values['strategies']): ?>
                        <div class="card__content">
                            <p class="text--sm text--muted">No section has an &lt;seo&gt; block yet. Add one to a section with pages of its own in admin.xml.</p>
                        </div>
<?php else: ?>
                        <div class="card__content">
                            <table class="table table--hoverable table--card">
                                <thead class="table__header">
                                    <tr class="table__row">
                                        <th class="table__head">Section</th>
                                        <th class="table__head">Schema type</th>
<?php foreach ($values['roles'] as $role): ?>
                                        <th class="table__head"><?= $view->escape($labels[$role]) ?></th>
<?php endforeach ?>
                                        <th class="table__head">Content</th>
                                        <th class="table__head"></th>
                                    </tr>
                                </thead>
                                <tbody class="table__body">
<?php foreach ($values['strategies'] as $strategy): ?>
                                    <tr class="table__row">
                                        <td class="table__cell"><a class="text--medium" href="<?= $view->escape($view->url('strategy', ['section' => $strategy->section])) ?>"><?= $view->escape($strategy->title) ?></a></td>
                                        <td class="table__cell"><?= '' === $strategy->schema ? '<span class="text--muted">–</span>' : $view->escape($strategy->schema) ?></td>
<?php foreach ($values['roles'] as $role): ?>
                                        <td class="table__cell"><?= $view->escape($strategy->sourcesLine($role)) ?></td>
<?php endforeach ?>
                                        <td class="table__cell"><?= $strategy->automatic ? 'Automatic' : 'Manual' ?></td>
                                        <td class="table__cell"><a class="btn btn--outline btn--sm" href="<?= $view->escape($view->url('strategy', ['section' => $strategy->section])) ?>"><?= $values['saves'] ? 'Change' : 'View' ?></a></td>
                                    </tr>
<?php endforeach ?>
                                </tbody>
                            </table>
                        </div>
<?php endif ?>
                    </section>
<?php endif ?>
                </div>
