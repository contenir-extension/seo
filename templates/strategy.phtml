<?php
/**
 * How each section's pages are described for search: the schema type and where the title, description and image
 * are read from, listed, and one section's form to change them where the site saves its configuration.
 *
 * @var array{
 *     strategies: list<\Contenir\Extension\Seo\Strategy\SectionStrategy>,
 *     editing: ?\Contenir\Extension\Seo\Strategy\SectionStrategy,
 *     saves: bool,
 *     version: string,
 *     roles: list<string>,
 * } $values
 * @var \Contenir\Extension\Api\Module\TemplateHelpersInterface $view
 */

$labels  = ['title' => 'Title', 'description' => 'Description', 'image' => 'Image'];
$editing = $values['editing'];
?>
                <div class="pageheader pageheader--row pageheader--sticky">
                    <div class="pageheader__content">
                        <h1 class="pageheader__title">SEO</h1>
                    </div>
                </div>
                <?= $view->tabs() ?>

                <div class="stack stack--lg">
<?php if (! $values['saves']): ?>
                    <div class="alert alert--info" role="note">
                        <p class="alert__text">This site saves its configuration where it is developed, not here. To change how a section is described, change its &lt;seo&gt; block in admin.xml and deploy.</p>
                    </div>
<?php endif ?>
<?php if (null !== $editing): ?>
                    <form method="post" action="<?= $view->escape($view->url('strategy-save')) ?>" class="card">
                        <?= $view->token() ?>
                        <input type="hidden" name="section" value="<?= $view->escape($editing->section) ?>">
                        <input type="hidden" name="version" value="<?= $view->escape($values['version']) ?>">
                        <div class="card__header">
                            <h2 class="card__title"><?= $view->escape($editing->title) ?></h2>
                            <p class="card__description">Each role is read from the first field below that holds a value.</p>
                        </div>
                        <div class="card__content stack stack--md">
                            <div class="form__field">
                                <label class="form__label" for="strategy-schema">Schema type</label>
                                <input class="input" type="text" id="strategy-schema" name="schema" list="strategy-schemas" value="<?= $view->escape($editing->schema) ?>" placeholder="WebPage"<?= $values['saves'] ? '' : ' disabled' ?>>
                                <datalist id="strategy-schemas">
<?php foreach (['WebPage', 'Article', 'BlogPosting', 'NewsArticle', 'CreativeWork', 'Product', 'Event', 'Person', 'Organization', 'LocalBusiness'] as $type): ?>
                                    <option value="<?= $view->escape($type) ?>"></option>
<?php endforeach ?>
                                </datalist>
                            </div>
<?php foreach ($values['roles'] as $role): ?>
<?php $chosen = $editing->sourcesOf($role); $slots = max(3, count($chosen) + 1); $options = array_values(array_unique([...$editing->fields, ...$chosen])); ?>
                            <fieldset class="form__field">
                                <legend class="form__label"><?= $view->escape($labels[$role]) ?> comes from</legend>
                                <div class="cluster cluster--sm">
<?php for ($slot = 0; $slot < $slots; ++$slot): ?>
                                    <select class="select select--auto" name="sources[<?= $view->escape($role) ?>][]" aria-label="<?= $view->escape($labels[$role]) ?> source <?= $slot + 1 ?>"<?= $values['saves'] ? '' : ' disabled' ?>>
                                        <option value="">–</option>
<?php foreach ($options as $field): ?>
                                        <option value="<?= $view->escape($field) ?>"<?= ($chosen[$slot] ?? null) === $field ? ' selected' : '' ?>><?= $view->escape($field) ?></option>
<?php endforeach ?>
                                    </select>
<?php endfor ?>
                                </div>
<?php if (in_array($role, ['description', 'image'], true)): ?>
                                <label class="checkbox"><input type="hidden" name="content[<?= $view->escape($role) ?>]" value="0"><input type="checkbox" class="checkbox__input" name="content[<?= $view->escape($role) ?>]" value="1"<?= $editing->takesContent($role) ? ' checked' : '' ?><?= $values['saves'] ? '' : ' disabled' ?>> <span>From content, where those are empty</span></label>
<?php endif ?>
<?php if ('image' === $role): ?>
                                <div class="form__field">
                                    <label class="form__label" for="strategy-alt">Alt text comes from</label>
                                    <select class="select select--auto" id="strategy-alt" name="alt"<?= $values['saves'] ? '' : ' disabled' ?>>
                                        <option value="">The title</option>
<?php foreach (array_values(array_unique([...$editing->fields, ...('' === $editing->altSource() ? [] : [$editing->altSource()])])) as $field): ?>
                                        <option value="<?= $view->escape($field) ?>"<?= $editing->altSource() === $field ? ' selected' : '' ?>><?= $view->escape($field) ?></option>
<?php endforeach ?>
                                    </select>
                                </div>
<?php endif ?>
                            </fieldset>
<?php endforeach ?>
                            <fieldset class="form__field">
                                <legend class="form__label">What is taken from content</legend>
                                <div class="radio-group" role="radiogroup">
                                    <label class="radio-group__item"><input type="radio" class="radio-group__input" name="mode" value="automatic"<?= $editing->automatic ? ' checked' : '' ?><?= $values['saves'] ? '' : ' disabled' ?>><span class="radio-group__label">Automatic: the page uses it, and the record shows "Taken from content" with nothing to fix</span></label>
                                    <label class="radio-group__item"><input type="radio" class="radio-group__input" name="mode" value="manual"<?= $editing->automatic ? '' : ' checked' ?><?= $values['saves'] ? '' : ' disabled' ?>><span class="radio-group__label">Manual: it is only a suggestion, and the record keeps its warning until you use it as the record's own</span></label>
                                </div>
                            </fieldset>
                        </div>
                        <div class="card__footer">
<?php if ($values['saves']): ?>
                            <button type="submit" class="btn btn--primary">Save</button>
<?php endif ?>
                            <a class="btn btn--outline" href="<?= $view->escape($view->url('strategy')) ?>">Back to the sections</a>
                        </div>
                    </form>
<?php else: ?>
                    <section class="card">
<?php if ([] === $values['strategies']): ?>
                        <div class="card__content">
                            <p class="text--sm text--muted">No section has an &lt;seo&gt; block yet. Add one to a section with pages of its own in admin.xml.</p>
                        </div>
<?php else: ?>
                        <div class="card__content">
                            <table class="table table--hoverable table--card">
                                <thead class="table__header">
                                    <tr class="table__row">
                                        <th class="table__head">Section</th>
                                        <th class="table__head">Schema type</th>
<?php foreach ($values['roles'] as $role): ?>
                                        <th class="table__head"><?= $view->escape($labels[$role]) ?></th>
<?php endforeach ?>
                                        <th class="table__head">Content</th>
                                        <th class="table__head"></th>
                                    </tr>
                                </thead>
                                <tbody class="table__body">
<?php foreach ($values['strategies'] as $strategy): ?>
                                    <tr class="table__row">
                                        <td class="table__cell"><a class="text--medium" href="<?= $view->escape($view->url('strategy', ['section' => $strategy->section])) ?>"><?= $view->escape($strategy->title) ?></a></td>
                                        <td class="table__cell"><?= '' === $strategy->schema ? '<span class="text--muted">–</span>' : $view->escape($strategy->schema) ?></td>
<?php foreach ($values['roles'] as $role): ?>
                                        <td class="table__cell"><?= $view->escape($strategy->sourcesLine($role)) ?></td>
<?php endforeach ?>
                                        <td class="table__cell"><?= $strategy->automatic ? 'Automatic' : 'Manual' ?></td>
                                        <td class="table__cell"><a class="btn btn--outline btn--sm" href="<?= $view->escape($view->url('strategy', ['section' => $strategy->section])) ?>"><?= $values['saves'] ? 'Change' : 'View' ?></a></td>
                                    </tr>
<?php endforeach ?>
                                </tbody>
                            </table>
                        </div>
<?php endif ?>
                    </section>
<?php endif ?>
                </div>
