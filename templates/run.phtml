<?php
/**
 * How a bulk fix went: each change and what became of it, with an Undo while the values it replaced are fresh.
 *
 * @var array{
 *     run: \Contenir\Extension\Seo\Bulk\Run,
 *     undoable: bool,
 *     now: int,
 * } $values
 * @var \Contenir\Extension\Api\Module\TemplateHelpersInterface $view
 */

use Contenir\Extension\Seo\Bulk\Run;
use Contenir\Extension\Seo\Bulk\RunChange;
use Contenir\Extension\Seo\Health\Age;

$run     = $values['run'];
$states  = [Run::QUEUED => 'Waiting to start', Run::RUNNING => 'Applying', Run::FINISHED => 'Finished'];
$results = [
    RunChange::PENDING => ['Waiting', 'secondary'],
    RunChange::DONE    => ['Saved', 'success-muted'],
    RunChange::STOPPED => ['Held back', 'warning-muted'],
    RunChange::FAILED  => ['Failed', 'destructive-muted'],
    RunChange::SKIPPED => ['Left alone', 'warning-muted'],
    RunChange::UNDONE  => ['Put back', 'secondary'],
];
$shown  = static fn(?string $value): string => null === $value || '' === $value ? '–' : $value;
$switch = static fn(?string $value): string => null === $value || '0' === $value ? 'No' : 'Yes';
?>
                <?= $view->tabs() ?>

                <div class="card">
                    <div class="card__header card__header--row">
                        <div>
                            <h2 class="card__title"><?= $view->escape($run->kind->label()) ?> <span class="badge badge--secondary"><?= $view->escape($states[$run->state] ?? $run->state) ?></span></h2>
                            <p class="card__description">Asked by <?= $view->escape($run->editor) ?> <?= $view->escape(Age::of($values['now'] - $run->at)) ?> ago. <?= $run->count(RunChange::DONE) ?> saved<?= 0 < $run->count(RunChange::STOPPED) ? ', ' . $run->count(RunChange::STOPPED) . ' held back' : '' ?><?= 0 < $run->count(RunChange::FAILED) ? ', ' . $run->count(RunChange::FAILED) . ' failed' : '' ?><?= 0 < $run->count(RunChange::SKIPPED) ? ', ' . $run->count(RunChange::SKIPPED) . ' left alone' : '' ?><?= 0 < $run->count(RunChange::UNDONE) ? ', ' . $run->count(RunChange::UNDONE) . ' put back' : '' ?>.</p>
                        </div>
                        <div class="cluster cluster--sm">
<?php if (Run::FINISHED !== $run->state): ?>
                            <a class="btn btn--outline btn--sm" href="<?= $view->escape($view->url('records-run', ['run' => $run->id])) ?>"><?= $view->icon('refresh') ?><span>Refresh</span></a>
<?php endif ?>
<?php if ($values['undoable']): ?>
                            <form method="post" action="<?= $view->escape($view->url('records-undo')) ?>">
                                <?= $view->token() ?>
                                <input type="hidden" name="run" value="<?= $view->escape($run->id) ?>">
                                <button type="submit" class="btn btn--outline btn--sm"><span>Undo</span></button>
                            </form>
<?php endif ?>
                            <a class="btn btn--ghost btn--sm" href="<?= $view->escape($view->url('records')) ?>"><span>Back to Records</span></a>
                        </div>
                    </div>
                    <div class="table__wrapper table__wrapper--borderless">
                        <table class="table table--card">
                            <thead class="table__header">
                                <tr class="table__row">
                                    <th class="table__head">Record</th>
                                    <th class="table__head">Property</th>
                                    <th class="table__head">Before</th>
                                    <th class="table__head">After</th>
                                    <th class="table__head">Result</th>
                                </tr>
                            </thead>
                            <tbody class="table__body">
<?php foreach ($run->changes as $change): ?>
<?php [$label, $tone] = $results[$change->status] ?? [$change->status, 'secondary']; ?>
                                <tr class="table__row">
                                    <td class="table__cell"><span class="text--medium"><?= $view->escape($change->title) ?></span><span class="text--sm text--muted" style="display: block"><?= $view->escape($change->sectionTitle) ?></span></td>
                                    <td class="table__cell"><?= $view->escape($run->kind->property()) ?></td>
                                    <td class="table__cell text--muted"><?= $view->escape($run->kind->editable() ? $shown($change->before) : $switch($change->before)) ?></td>
                                    <td class="table__cell"><?= $view->escape($run->kind->editable() ? $change->after : $switch($change->after)) ?></td>
                                    <td class="table__cell"><span class="badge badge--<?= $view->escape($tone) ?>"><?= $view->escape($label) ?></span><?php if ('' !== $change->message): ?> <span class="text--sm text--muted"><?= $view->escape($change->message) ?></span><?php endif ?></td>
                                </tr>
<?php endforeach ?>
                            </tbody>
                        </table>
                    </div>
                </div>
