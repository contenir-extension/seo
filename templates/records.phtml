<?php
/**
 * The search report: a header with what to do here, Fix and Export for everything the filters
 * match, the filters, then the records as the host's own list, whose ticked rows can be fixed too.
 *
 * @var array{
 *     sections: list<\Contenir\Extension\Seo\Report\SectionIssues>,
 *     roles: array<string, string>,
 *     filter: \Contenir\Extension\Seo\Module\RecordFilter,
 *     total: int,
 *     page: int,
 *     pages: int,
 *     rows: list<\Contenir\Extension\Seo\Module\RecordLine>,
 *     bulk: bool,
 *     kinds: array<string, string>,
 * } $values
 * @var \Contenir\Extension\Api\Module\TemplateHelpersInterface $view
 */
use Contenir\Extension\Seo\Bulk\FixKind;
use Contenir\Extension\Seo\Bulk\Selection;
use Contenir\Extension\Seo\Module\RecordsList;

$filter = $values['filter'];
$bulk   = $values['bulk'] && [] !== $values['rows'];
$list   = (new RecordsList($filter, $values['rows'], $values['page'], $values['total'], $values['bulk']))->of($view);
?>
                <div class="pageheader pageheader--row pageheader--sticky">
                    <div class="pageheader__content">
                        <h1 class="pageheader__title">Records</h1>
                    </div>
                    <div class="pageheader__actions">
                        <a class="btn btn--outline" href="<?= $view->escape($view->url('records-export', $filter->query())) ?>"><?= $view->icon('table-export') ?><span>Export CSV</span></a>
<?php if ($bulk): ?>
                        <form id="seo-fix-all" method="post" action="<?= $view->escape($view->url('records-fix')) ?>" hidden>
                            <?= $view->token() ?>
                            <input type="hidden" name="scope" value="<?= Selection::ALL ?>">
<?php foreach ($filter->query() as $name => $value): ?>
                            <input type="hidden" name="<?= $view->escape($name) ?>" value="<?= $view->escape($value) ?>">
<?php endforeach ?>
                        </form>
                        <div class="dropdown dropdown--right">
                            <button type="button" class="btn btn--primary dropdown__trigger" aria-haspopup="menu" aria-expanded="false" data-toggle data-toggle-target="#seo-fix-menu" data-toggle-capture="true"><span>Fix all <?= $values['total'] ?></span><?= $view->icon('chevron-down') ?></button>
                            <div class="dropdown__menu dropdown__menu--sm" id="seo-fix-menu" role="menu" popover="manual">
<?php foreach (FixKind::cases() as $fix): ?>
                                <button type="submit" form="seo-fix-all" name="fix" value="<?= $view->escape($fix->value) ?>" class="dropdown__item" role="menuitem"><?= $view->icon($fix->icon()) ?><span class="dropdown__item-text"><?= $view->escape($fix->label()) ?></span></button>
<?php endforeach ?>
                            </div>
                        </div>
<?php endif ?>
                    </div>
                </div>
                <p class="pageheader__description">The published records that need something. Open one to fix it, tick several to fix them together, or use Fix for everything these filters match. You review a fix before it's applied.</p>

                <?= $view->tabs() ?>

                <div class="card">
                    <div class="card__content card__content--pt">
                        <div class="toolbar">
                            <form class="cluster cluster--sm flex--1" method="get" action="<?= $view->escape($view->url('records')) ?>">
                                <select name="section" class="select select--auto" aria-label="Section" data-autosubmit="1">
                                    <option value="">All sections</option>
<?php foreach ($values['sections'] as $section): ?>
                                    <option value="<?= $view->escape($section->section) ?>"<?= $filter->section === $section->section ? ' selected' : '' ?>><?= $view->escape($section->title) ?></option>
<?php endforeach ?>
                                </select>
                                <select name="role" class="select select--auto" aria-label="Issue" data-autosubmit="1">
                                    <option value="">All issues</option>
<?php foreach ($values['roles'] as $role => $label): ?>
                                    <option value="<?= $view->escape($role) ?>"<?= $filter->role === $role ? ' selected' : '' ?>><?= $view->escape($label) ?></option>
<?php endforeach ?>
                                </select>
                                <select name="kind" class="select select--auto" aria-label="Problem" data-autosubmit="1">
                                    <option value="">Any problem</option>
<?php foreach ($values['kinds'] as $kind => $label): ?>
                                    <option value="<?= $view->escape($kind) ?>"<?= $filter->kind?->value === $kind ? ' selected' : '' ?>><?= $view->escape($label) ?></option>
<?php endforeach ?>
                                </select>
                                <button type="submit" class="sr-only">Filter</button>
                            </form>
                        </div>
                    </div>

                    <?= $view->recordList($list) ?>
                </div>
