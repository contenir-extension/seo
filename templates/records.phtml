<?php
/**
 * The search report: filters by section and role, an export of what they
 * show, then a row per record with its issues and where to fix it.
 *
 * @var array{
 *     sections: list<\Contenir\Extension\Seo\Report\SectionIssues>,
 *     roles: array<string, string>,
 *     filter: \Contenir\Extension\Seo\Module\RecordFilter,
 *     total: int,
 *     page: int,
 *     pages: int,
 *     from: int,
 *     rows: list<\Contenir\Extension\Seo\Module\RecordLine>,
 * } $values
 * @var \Contenir\Extension\Api\Module\TemplateHelpersInterface $view
 */
$filter  = $values['filter'];
$pageUrl = static fn(int $page): string => $view->url('records', $filter->query() + ['page' => $page]);
?>
                <?= $view->tabs() ?>

                <div class="card">
                    <div class="card__content card__content--pt">
                        <div class="toolbar">
                            <form class="cluster cluster--sm flex--1" method="get" action="<?= $view->escape($view->url('records')) ?>">
                                <select name="section" class="select select--auto" aria-label="Section" data-autosubmit="1">
                                    <option value="">All sections</option>
<?php foreach ($values['sections'] as $section): ?>
                                    <option value="<?= $view->escape($section->section) ?>"<?= $filter->section === $section->section ? ' selected' : '' ?>><?= $view->escape($section->title) ?></option>
<?php endforeach ?>
                                </select>
                                <select name="role" class="select select--auto" aria-label="Issue" data-autosubmit="1">
                                    <option value="">All issues</option>
<?php foreach ($values['roles'] as $role => $label): ?>
                                    <option value="<?= $view->escape($role) ?>"<?= $filter->role === $role ? ' selected' : '' ?>><?= $view->escape($label) ?></option>
<?php endforeach ?>
                                </select>
                                <button type="submit" class="sr-only">Filter</button>
                            </form>
                            <a class="btn btn--outline" href="<?= $view->escape($view->url('records-export', $filter->query())) ?>"><?= $view->icon('table-export') ?><span>Export CSV</span></a>
                        </div>
                    </div>

<?php if ([] === $values['rows']): ?>
                    <div class="card__content">
                        <div class="empty">
                            <div class="empty__content">
                                <h2 class="empty__title">Nothing to fix</h2>
                                <p class="empty__description">No record matches these filters.</p>
                            </div>
                        </div>
                    </div>
<?php else: ?>
                    <div class="table__wrapper table__wrapper--borderless">
                        <table class="table table--hoverable table--card">
                            <thead class="table__header">
                                <tr class="table__row">
                                    <th class="table__head">Record</th>
                                    <th class="table__head">Section</th>
                                    <th class="table__head">To fix</th>
                                    <th class="table__head table__actions"><span class="sr-only">Links</span></th>
                                </tr>
                            </thead>
                            <tbody class="table__body">
<?php foreach ($values['rows'] as $row): ?>
                                <tr class="table__row">
                                    <td class="table__cell"><?php if (null === $row->edit): ?><?= $view->escape($row->row->record->title) ?><?php else: ?><a class="text--medium" href="<?= $view->escape($row->edit) ?>"><?= $view->escape($row->row->record->title) ?></a><?php endif ?></td>
                                    <td class="table__cell text--muted"><?= $view->escape($row->row->section->title) ?></td>
                                    <td class="table__cell">
<?php foreach ($row->issues as $issue): ?>
                                        <div><?= $view->escape($issue) ?></div>
<?php endforeach ?>
                                    </td>
                                    <td class="table__cell table__actions"><a class="btn btn--ghost btn--sm" href="<?= $view->escape($view->url('preview', ['section' => $row->row->section->section, 'id' => $row->row->record->record->id])) ?>"><?= $view->icon('eye') ?><span class="sr-only">Preview in search</span></a><?php if (null !== $row->view): ?><a class="btn btn--ghost btn--sm" href="<?= $view->escape($row->view) ?>" target="_blank" rel="noopener"><?= $view->icon('external-link') ?><span class="sr-only">View the page</span></a><?php endif ?></td>
                                </tr>
<?php endforeach ?>
                            </tbody>
                        </table>
                    </div>

                    <div class="card__footer card__footer--border">
                        <div class="pagination__info">
                            <div class="pagination__text">Showing <strong><?= $values['from'] ?></strong> to <strong><?= $values['from'] + count($values['rows']) - 1 ?></strong> of <strong><?= $values['total'] ?></strong></div>
<?php if ($values['pages'] > 1): ?>
                            <nav class="pagination" aria-label="Pages">
<?php if ($values['page'] > 1): ?>
                                <a class="pagination__prev" href="<?= $view->escape($pageUrl($values['page'] - 1)) ?>" aria-label="Previous page"><?= $view->icon('chevron-left') ?></a>
<?php endif ?>
<?php if ($values['page'] < $values['pages']): ?>
                                <a class="pagination__next" href="<?= $view->escape($pageUrl($values['page'] + 1)) ?>" aria-label="Next page"><?= $view->icon('chevron-right') ?></a>
<?php endif ?>
                            </nav>
<?php endif ?>
                        </div>
                    </div>
<?php endif ?>
                </div>
